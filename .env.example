# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require
NEON_DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Session Secret (Generate a secure random string for production)
SESSION_SECRET=your-secure-random-secret-key-change-in-production

# Canonical public origin used for same-origin request verification
PUBLIC_ORIGIN=https://dankook-graduate.onrender.com

# Administrator credentials (generate the hash with: npm run security:hash-password)
# ADMIN_USERNAME=set-in-deployment-platform
# ADMIN_PASSWORD_HASH=set-generated-scrypt-hash-in-deployment-platform

# Optional comma-separated additional trusted origins (normally leave empty)
ALLOWED_ORIGINS=

# Node Environment
NODE_ENV=production
